# Copy to .env (or set as environment variables). All keys are optional.

# Enables the database, scheduled tests, registration and admin endpoints.
BRAVA_ADVANCED_MODE=false
# URL prefix of the app (frontend under <base path>/, API under <base path>/api).
BRAVA_BASE_PATH=/brapivalidator
# Collections/schemas and the frontend (defaults point into the Java source tree).
#BRAVA_RESOURCES_DIR=../src/main/resources
#BRAVA_FRONTEND_DIR=../src/main/webapp/advanced
# Restrict the versions offered (default: every collection file found).
#BRAVA_AVAILABLE_VERSIONS=v1.0,v1.1,v1.2,v1.3,v2.0,v2.1
BRAVA_TESTED_VERSION=v2.1

# Requests to tested servers
#BRAVA_HTTP_PROXY=http://proxy:3128
BRAVA_VERIFY_TLS=true
BRAVA_REQUEST_TIMEOUT=300

# Advanced mode
# SQLAlchemy async URLs, e.g. oracle+oracledb_async://user:pass@host:1521/?service_name=svc,
# postgresql+asyncpg://user:pass@host/brava, mysql+aiomysql://user:pass@host/brava
BRAVA_DATABASE_URL=sqlite+aiosqlite:///brava.db
BRAVA_ADMIN_KEY=change-me
# Public URL of the frontend, used for links in emails.
BRAVA_BASE_DOMAIN=http://localhost:8000/brapivalidator
BRAVA_CONTACT_EMAIL=brava@example.org
BRAVA_SENDER_NAME=The BRAVA team
BRAVA_RESOURCE_JSON_URL=https://brapi.org/json/brapi-resources.json
#BRAVA_AUTO_IMPORT_RESOURCES=true
BRAVA_KEEP_REPORTS=3
#BRAVA_TIMEZONE=Europe/Berlin

# Mail
#BRAVA_SMTP_HOST=localhost
BRAVA_SMTP_PORT=25
#BRAVA_SMTP_USER=
#BRAVA_SMTP_PASSWORD=
BRAVA_SMTP_STARTTLS=false
BRAVA_MAIL_FROM=brava@example.org
BRAVA_MAIL_FROM_NAME=BRAVA
