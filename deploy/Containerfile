# BRAVA image: Python backend + Svelte frontend.
# Advanced mode (SQLite in /data/db) is the default; the mode is chosen at runtime via
# BRAVA_ADVANCED_MODE (deploy/deploy.sh --mode advanced|simple).
# Build from the repository / bundle root:  deploy/build-image.sh
#   (or: podman build -f deploy/Containerfile -t localhost/brava:latest .)

# --- Svelte frontend ---------------------------------------------------------
FROM docker.io/library/node:24-bookworm-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN rm -rf dist node_modules/.vite && npm run build

# --- Python backend ----------------------------------------------------------
# Official Python image plus the uv binary (uv's own python3.14 images are not published for
# every uv version/Debian release); the runtime stage uses the same base, so the venv matches.
FROM docker.io/library/python:3.14-slim-trixie AS backend
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY python/pyproject.toml python/uv.lock python/README.md ./
RUN uv sync --locked --no-dev --no-install-project --extra oracle --extra postgres --extra mysql
COPY python/src ./src
RUN uv sync --locked --no-dev --extra oracle --extra postgres --extra mysql

# --- Runtime -----------------------------------------------------------------
FROM docker.io/library/python:3.14-slim-trixie
RUN useradd --create-home --uid 1000 brava
WORKDIR /app
COPY --from=backend /app /app
COPY resources/collections /data/resources/collections
COPY resources/schemas /data/resources/schemas
COPY --from=frontend /frontend/dist /data/frontend
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    BRAVA_ADVANCED_MODE=true \
    BRAVA_RESOURCES_DIR=/data/resources \
    BRAVA_FRONTEND_DIR=/data/frontend \
    BRAVA_DATABASE_URL=sqlite+aiosqlite:////data/db/brava.db
# SQLite database directory; mount a volume here to keep the data (the quadlet uses "brava-data").
RUN mkdir -p /data/db && chown brava /data/db
USER brava
EXPOSE 8000
CMD ["brava", "serve", "--host", "0.0.0.0", "--port", "8000"]
