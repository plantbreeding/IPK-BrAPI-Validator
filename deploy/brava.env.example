# BRAVA container settings (copied to ~/.config/brava/brava.env by deploy/deploy.sh).
# Uncomment to override. Restart after a change:
#   systemctl --user restart brava.service
#
# Do not set BRAVA_ADVANCED_MODE here: the mode is chosen with deploy.sh --mode advanced|simple.
# In advanced mode deploy.sh appends BRAVA_ADMIN_KEY (random), BRAVA_BASE_DOMAIN and
# BRAVA_TIMEZONE below if they are not set yet.

# URL prefix of the app (frontend under <base path>/, API under <base path>/api).
#BRAVA_BASE_PATH=/brapivalidator

# Restrict the BrAPI versions offered (default: every collection file found).
#BRAVA_AVAILABLE_VERSIONS=v1.0,v1.1,v1.2,v1.3,v2.0,v2.1
#BRAVA_TESTED_VERSION=v2.1

# Requests to tested servers
#BRAVA_HTTP_PROXY=http://proxy:3128
#BRAVA_VERIFY_TLS=true
#BRAVA_REQUEST_TIMEOUT=300

# ---- Advanced mode ---------------------------------------------------------
# Database: default is SQLite in the "brava-data" volume. Other SQLAlchemy async URLs:
#   oracle+oracledb_async://user:pass@host:1521/?service_name=svc
#   postgresql+asyncpg://user:pass@host/brava
#   mysql+aiomysql://user:pass@host/brava
#BRAVA_DATABASE_URL=sqlite+aiosqlite:////data/db/brava.db

# Key for the /api/admin endpoints (HTTP basic auth, password = key).
#BRAVA_ADMIN_KEY=change-me
# Public URL of the frontend, used for links in emails.
#BRAVA_BASE_DOMAIN=http://server.example.org:10000/brapivalidator
#BRAVA_CONTACT_EMAIL=brava@example.org
#BRAVA_SENDER_NAME=The BRAVA team
#BRAVA_RESOURCE_JSON_URL=https://brapi.org/json/brapi-resources.json
# Import that list on startup while there is no public resource in the database.
#BRAVA_AUTO_IMPORT_RESOURCES=true
#BRAVA_KEEP_REPORTS=3
# Time zone of the scheduled tests (08:00 daily/weekly/monthly).
#BRAVA_TIMEZONE=Europe/Berlin

# Mail (registration confirmations and test reports)
#BRAVA_SMTP_HOST=smtp.example.org
#BRAVA_SMTP_PORT=25
#BRAVA_SMTP_USER=
#BRAVA_SMTP_PASSWORD=
#BRAVA_SMTP_STARTTLS=false
#BRAVA_MAIL_FROM=brava@example.org
#BRAVA_MAIL_FROM_NAME=BRAVA
