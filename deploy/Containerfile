# BRAVA image: Python backend + Svelte frontend (simple mode).
# Build from the repository / bundle root:  deploy/build-image.sh
#   (or: podman build -f deploy/Containerfile -t localhost/brava:latest .)

# --- Svelte frontend ---------------------------------------------------------
FROM docker.io/library/node:24-bookworm-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN rm -rf dist node_modules/.vite && npm run build

# --- Python backend ----------------------------------------------------------
FROM ghcr.io/astral-sh/uv:0.12-python3.14-bookworm-slim AS backend
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY python/pyproject.toml python/uv.lock python/README.md ./
RUN uv sync --locked --no-dev --no-install-project
COPY python/src ./src
RUN uv sync --locked --no-dev

# --- Runtime -----------------------------------------------------------------
FROM docker.io/library/python:3.14-slim-bookworm
RUN useradd --create-home --uid 1000 brava
WORKDIR /app
COPY --from=backend /app /app
COPY src/main/resources/collections /data/resources/collections
COPY src/main/resources/schemas /data/resources/schemas
COPY --from=frontend /frontend/dist /data/frontend
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    BRAVA_ADVANCED_MODE=false \
    BRAVA_RESOURCES_DIR=/data/resources \
    BRAVA_FRONTEND_DIR=/data/frontend
USER brava
EXPOSE 8000
CMD ["brava", "serve", "--host", "0.0.0.0", "--port", "8000"]
